{
  "name": "alicent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/rich-text-spike",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @alicent/desktop",
    "desktop": "npm run tauri -w @alicent/desktop -- dev",
    "build": "npm run build -w @alicent/desktop",
    "typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p apps/rich-text-spike/tsconfig.json --noEmit",
    "lint": "eslint apps/desktop/src apps/rich-text-spike/src packages/contracts/src",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:accessibility": "playwright test tests/accessibility.spec.ts",
    "test:diagnostics-contract": "node --test tests/contracts/diagnostics-preview.test.cjs",
    "test:native:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-windows-e2e.ps1",
    "bench:storage": "cargo run --locked --release -p alicent-project-repository --example performance --",
    "bench:rich-text": "npm run bench -w @alicent/rich-text-spike",
    "spike:rich-text": "npm run dev -w @alicent/rich-text-spike",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:ci && npm run test:diagnostics-contract && npm run build",
    "postinstall": "node scripts/generate-icon.mjs",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,tsx,css}\" \"apps/rich-text-spike/**/*.{ts,css,html}\" \"packages/contracts/src/*.ts\"",
    "format:check": "prettier --check \"apps/desktop/src/**/*.{ts,tsx,css}\" \"apps/rich-text-spike/**/*.{ts,css,html}\" \"packages/contracts/src/*.ts\"",
    "test:ci": "node --test scripts/report-ci.test.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
